# Same database as the worker. The monitor only reads; every session is read-only.
DATABASE_URL=

# The worker's public health check, e.g. https://worker.example/health
WORKER_HEALTH_URL=

# Railway blocks outbound SMTP below the Pro plan. With a Resend key the SMTP
# settings are not needed; FROM_EMAIL must be on a domain verified in Resend
# (or onboarding@resend.dev, which only delivers to the Resend account's email).
RESEND_API_KEY=

# Operator email, same SMTP account as the worker's ops alerts.
SMTP_SERVER=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
OPS_ALERT_EMAIL=

# Railway sets PORT; the external uptime check watches GET /health here.
PORT=8080
