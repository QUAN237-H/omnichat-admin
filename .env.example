# Same Supabase project as the dashboard and worker. Anon/publishable key only,
# never the service role: every privileged read goes through the worker.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The worker's /admin/* routes. Server-side only, never NEXT_PUBLIC.
# For local ops against production, use the Railway worker HTTPS URL
# (same value as dashboard WORKER_INTERNAL_URL). Do not start a local
# worker on a number that is already linked in production.
WORKER_INTERNAL_URL=https://<your-worker>.up.railway.app
